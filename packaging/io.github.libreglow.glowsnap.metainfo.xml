<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.libreglow.glowsnap</id>

  <name>GlowSnap</name>

  <summary>Screenshot, screen recording and annotation tool</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.libreglow">
    <name>LibreGlow</name>
  </developer>

  <launchable type="desktop-id">io.github.libreglow.glowsnap.desktop</launchable>

  <description>
    <p>
      GlowSnap is a lightweight screenshot and screen recording application
      for Linux. It supports screenshots, screen recording, and a built-in
      annotation editor with Wayland support through xdg-desktop-portal.
    </p>

    <p>Main features:</p>

    <ul>
      <li>Take screenshots</li>
      <li>Record the screen</li>
      <li>Built-in image editor</li>
      <li>Drawing and annotation tools</li>
      <li>Wayland support via xdg-desktop-portal</li>
    </ul>
  </description>

  <categories>
    <category>Graphics</category>
    <category>Utility</category>
  </categories>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/libreglow/glowsnap/main/docs/images/studio.png</image>
    </screenshot>

    <screenshot>
      <image>https://raw.githubusercontent.com/libreglow/glowsnap/main/docs/images/editor.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/libreglow/glowsnap</url>
  <url type="bugtracker">https://github.com/libreglow/glowsnap/issues</url>
  <url type="vcs-browser">https://github.com/libreglow/glowsnap</url>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0-alpha" date="2026-07-29"/>
  </releases>

  <provides>
    <binary>glowsnap</binary>
  </provides>
</component>